# SPDX-License-Identifier: Apache-2.0
#
# Recovery init for Motorola Edge 70 Fusion (marvel, Qualcomm SM7635 "volcano")
#
# Qualcomm/block/USB handling follows the official TeamWin Qualcomm trees
# (lemonadep, genevn). The Motorola touch bring-up follows the cybert tree.
#

on early-init
    mkdir /firmware 0771 system system
    mkdir /vendor/firmware_mnt 0771 system system

on init
    # Panel backlight (Motorola QTI panel0-backlight)
    write /sys/class/backlight/panel0-backlight/brightness 1200

    # Qualcomm USB controller for this device
    # (vendor.prop: ro.vendor.usb.controller=a600000.dwc3)
    setprop sys.usb.controller a600000.dwc3
    setprop sys.usb.configfs 1

on fs
    # gold: lemonadep/genevn "symlink bootdevice earlier"
    wait /dev/block/platform/soc/1d84000.ufshc
    symlink /dev/block/platform/soc/1d84000.ufshc /dev/block/bootdevice
    symlink /dev/block/platform/soc/1d84000.ufshc/by-name /dev/block/by-name

on post-fs
    # Motorola MMI touch stack (see touch_probe.sh)
    start recovery-touch

on boot
    setprop sys.usb.config adb

# ---------------------------------------------------------------------------
# Motorola touch stack.
# marvel uses the MMI touch layer with a Goodix BRL controller. The chip driver
# is listed in modules.blocklist, so it is never auto-loaded - recovery has to
# force the chain in. (cybert reference: touchscreen_u_mmi + goodix_brl_u_mmi +
# mmi_info/mmi_relay/sensors_class.)
# ---------------------------------------------------------------------------
service recovery-touch /system/bin/touch_probe.sh
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

# gold: lemonadep "wait before starting vibration and health service"
service health-hal /system/bin/android.hardware.health-service.qti
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
